# ============================================================
# BookVerse v1 — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# --- Clerk (Auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Clerk sign-in/sign-up redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional: only if you use the older Clerk JWT template instead of the Supabase integration
# CLERK_SUPABASE_JWT_TEMPLATE=supabase

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_ME

# --- Google Books API ---
GOOGLE_BOOKS_API_KEY=REPLACE_ME
